# Backend runtime. Never commit your real .env file or expose these keys in the browser.
PORT=8787
# Local origins are allowed automatically in development. In production, list exact frontend origins.
FRONTEND_URL=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
FRONTEND_URLS=
CORS_ALLOWED_ORIGINS=

# Groq API — generate keys at https://console.groq.com/keys
# Keep keys in this backend .env file only; never use VITE_ variables for secrets.
# Configure one key per numbered variable, or use GROQ_API_KEYS as a comma/newline-separated list.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEYS=
# Default currently supported Groq model; change only to a model available in your Groq account.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=60000

# Optional: language-aware YouTube Data API v3 video lookup.
YOUTUBE_API_KEY=

# Leave blank for local development via the Vite /api proxy. In production, set the backend API origin.
VITE_API_BASE_URL=

# Optional Razorpay server-side subscription setup.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
